          "weak",
          "medium",
          "strong",
          "very_strong"
        ],
        "x-enum-descriptions": {
          "values": {
            "unknown_score": "Unknown score",
            "very_weak": "Very weak",
            "weak": "Weak",
            "medium": "Medium",
            "strong": "Strong",
            "very_strong": "Very strong"
