            "lang": "cURL",
            "source": "curl -X GET \\\n  -H \"X-Auth-Token: $SCW_SECRET_KEY\" \\\n  \"https://api.scaleway.com/account/v3/projects?organization_id=string\""
          },
          {
            "lang": "HTTPie",
            "source": "http GET \"https://api.scaleway.com/account/v3/projects\" \\\n  X-Auth-Token:$SCW_SECRET_KEY \\\n  organization_id==string"
          }
        ]
      },
