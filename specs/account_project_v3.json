  "paths": {
    "/account/v3/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "operationId": "ListProjects",
        "summary": "List all Projects of an Organization",
        "description": "List all Projects of an Organization. The response will include the total number of Projects as well as their associated Organizations, names, and IDs. Other information includes the creation and update date of the Project.",
        "parameters": [
          {
            "in": "query",
            "name": "organization_id",
            "description": "Organization ID of the Project.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "name",
            "description": "Name of the Project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Page number for the returned Projects.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "description": "Maximum number of Project per page.",
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "in": "query",
            "name": "order_by",
            "description": "Sort order of the returned Projects.",
            "schema": {
              "$ref": "#/components/schemas/scaleway.account.v3.ListProjectsRequest.OrderBy"
            }
          },
          {
            "in": "query",
            "name": "project_ids",
            "description": "Project IDs to filter for. The results will be limited to any Projects with an ID in this array.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/scaleway.account.v3.ListProjectsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "scaleway": []
          }
        ],
        "x-codeSamples": [
