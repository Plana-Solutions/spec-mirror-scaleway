  "paths": {
    "/webhosting/v1/regions/{region}/dedibox-hostings/{domain}/migrate": {
      "post": {
        "tags": [
          "DediboxHostings"
        ],
        "operationId": "MigrateDediboxHosting",
        "summary": "Migrate a hosting from Dedibox to Scaleway account",
        "parameters": [
          {
            "in": "path",
            "name": "region",
            "description": "The region you want to target",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "fr-par"
              ]
            }
          },
          {
            "in": "path",
            "name": "domain",
            "description": "Domain linked with the Dedibox hosting.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/scaleway.webhosting.v1.Hosting"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": {
                    "type": "string",
                    "description": "Project ID to which the new migrated hosting will be attached."
                  },
                  "email": {
                    "type": "string",
                    "description": "Email provided while generating the token."
                  },
                  "token": {
                    "type": "string",
                    "description": "Token generated by the Dedibox console to validate the hosting migration."
                  }
                },
                "x-properties-order": [
                  "project_id",
                  "email",
                  "token"
                ]
              }
            }
          }
        },
        "security": [
          {
            "scaleway": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "cURL",
            "source": "curl -X POST \\\n  -H \"X-Auth-Token: $SCW_SECRET_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"email\": \"string\",\n    \"project_id\": \"string\",\n    \"token\": \"string\"\n  }' \\\n  \"https://api.scaleway.com/webhosting/v1/regions/{region}/dedibox-hostings/{domain}/migrate\""
          },
          {
            "lang": "HTTPie",
            "source": "http POST \"https://api.scaleway.com/webhosting/v1/regions/{region}/dedibox-hostings/{domain}/migrate\" \\\n  X-Auth-Token:$SCW_SECRET_KEY \\\n  email=\"string\" \\\n  project_id=\"string\" \\\n  token=\"string\""
          }
        ]
      }
    }
  }
