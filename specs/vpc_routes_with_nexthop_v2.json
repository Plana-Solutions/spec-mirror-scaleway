{
  "openapi": "3.1.0",
  "info": {
    "title": "Routes With Nexthop API",
    "version": "v2"
  },
  "servers": [
    {
      "url": "https://api.scaleway.com"
    }
  ],
  "components": {
    "schemas": {
      "scaleway.vpc.v2.ListRoutesWithNexthopRequest.OrderBy": {
        "type": "string",
        "enum": [
          "created_at_asc",
          "created_at_desc",
          "destination_asc",
          "destination_desc",
          "prefix_len_asc",
          "prefix_len_desc"
        ],
        "default": "created_at_asc"
      },
      "scaleway.vpc.v2.ListRoutesWithNexthopResponse": {
        "type": "object",
        "properties": {
          "routes": {
            "type": "array",
            "description": "List of routes.",
            "items": {
              "$ref": "#/components/schemas/scaleway.vpc.v2.RouteWithNexthop"
            }
          },
          "total_count": {
            "type": "integer",
            "description": "Total number of routes.",
            "format": "uint64"
          }
        },
        "x-properties-order": [
          "routes",
          "total_count"
        ]
      },
      "scaleway.vpc.v2.Route": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Route ID. (UUID format)",
            "example": "6170692e-7363-616c-6577-61792e636f6d"
          },
          "srn": {
            "type": "string",
            "description": "The SRN of the route.",
            "pattern": "^srn://vpc\\.[^/]+/regions/[^/]+/routes/[^/]+$"
          },
          "description": {
            "type": "string",
            "description": "Route description."
          },
          "tags": {
            "type": "array",
            "description": "Tags of the Route.",
            "items": {
              "type": "string"
            }
          },
          "vpc_id": {
            "type": "string",
            "description": "VPC the Route belongs to. (UUID format)",
            "example": "6170692e-7363-616c-6577-61792e636f6d"
          },
          "destination": {
            "type": "string",
            "description": "Destination of the Route. (IP network)",
            "example": "1.2.3.4/32"
          },
          "nexthop_resource_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID of the nexthop resource. (UUID format)",
            "example": "6170692e-7363-616c-6577-61792e636f6d"
          },
          "nexthop_private_network_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID of the nexthop private network. (UUID format)",
            "example": "6170692e-7363-616c-6577-61792e636f6d"
          },
          "nexthop_vpc_connector_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID of the nexthop VPC connector. (UUID format)",
            "example": "6170692e-7363-616c-6577-61792e636f6d"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date the Route was created. (RFC 3339 format)",
            "format": "date-time",
            "example": "2022-03-22T12:34:56.123456Z"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date the Route was last modified. (RFC 3339 format)",
            "format": "date-time",
            "example": "2022-03-22T12:34:56.123456Z"
          },
          "is_read_only": {
            "type": "boolean",
            "description": "Defines whether the route can be modified or deleted by the user."
          },
          "type": {
            "description": "Type of the Route.",
            "$ref": "#/components/schemas/scaleway.vpc.v2.RouteType"
          },
          "region": {
            "type": "string",
            "description": "Region of the Route."
          }
        },
        "x-properties-order": [
          "id",
          "srn",
          "description",
          "tags",
          "vpc_id",
          "destination",
          "nexthop_resource_id",
          "nexthop_private_network_id",
          "nexthop_vpc_connector_id",
          "created_at",
          "updated_at",
          "is_read_only",
          "type",
          "region"
        ]
      },
      "scaleway.vpc.v2.RouteType": {
        "type": "string",
        "enum": [
          "unknown_route_type",
          "subnet",
          "default",
          "custom",
          "interlink",
          "s2s_vpn"
        ],
        "default": "unknown_route_type"
      },
      "scaleway.vpc.v2.RouteWithNexthop": {
        "type": "object",
        "properties": {
          "route": {
            "description": "Route.",
            "$ref": "#/components/schemas/scaleway.vpc.v2.Route"
          },
          "nexthop_ip": {
            "type": [
              "string",
              "null"
            ],
            "description": "IP of the route's next hop. (IP address)",
            "example": "1.2.3.4"
          },
          "nexthop_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the route's next hop."
          },
          "nexthop_resource_type": {
            "description": "Resource type of the route's next hop.",
            "$ref": "#/components/schemas/scaleway.vpc.v2.RouteWithNexthop.ResourceType"
          }
        },
        "x-properties-order": [
          "route",
          "nexthop_ip",
          "nexthop_name",
          "nexthop_resource_type"
        ]
      },
      "scaleway.vpc.v2.RouteWithNexthop.ResourceType": {
        "type": "string",
        "enum": [
          "unknown_type",
          "vpc_gateway_network",
          "instance_private_nic",
          "baremetal_private_nic",
          "apple_silicon_private_nic",
          "vpn_gateway"
        ],
        "default": "unknown_type"
      }
    },
    "securitySchemes": {
      "scaleway": {
        "in": "header",
        "name": "X-Auth-Token",
        "type": "apiKey"
      }
    }
  },
  "paths": {
    "/vpc/v2/regions/{region}/routes-with-nexthop": {
      "get": {
        "operationId": "ListRoutesWithNexthop",
        "summary": "Return routes with associated next hop data",
        "parameters": [
          {
            "in": "path",
            "name": "region",
            "description": "The region you want to target",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order_by",
            "description": "Sort order of the returned routes.",
            "schema": {
              "$ref": "#/components/schemas/scaleway.vpc.v2.ListRoutesWithNexthopRequest.OrderBy"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Page number to return, from the paginated results.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "description": "Maximum number of routes to return per page.",
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "in": "query",
            "name": "vpc_id",
            "description": "VPC to filter for. Only routes within this VPC will be returned. (UUID format)",
            "schema": {
              "type": "string",
              "example": "6170692e-7363-616c-6577-61792e636f6d"
            }
          },
          {
            "in": "query",
            "name": "nexthop_resource_id",
            "description": "Next hop resource ID to filter for. Only routes with a matching next hop resource ID will be returned. (UUID format)",
            "schema": {
              "type": "string",
              "example": "6170692e-7363-616c-6577-61792e636f6d"
            }
          },
          {
            "in": "query",
            "name": "nexthop_private_network_id",
            "description": "Next hop private network ID to filter for. Only routes with a matching next hop private network ID will be returned. (UUID format)",
            "schema": {
              "type": "string",
              "example": "6170692e-7363-616c-6577-61792e636f6d"
            }
          },
          {
            "in": "query",
            "name": "nexthop_resource_type",
            "description": "Next hop resource type to filter for. Only Routes with a matching next hop resource type will be returned.",
            "schema": {
              "$ref": "#/components/schemas/scaleway.vpc.v2.RouteWithNexthop.ResourceType"
            }
          },
          {
            "in": "query",
            "name": "nexthop_vpc_connector_id",
            "description": "Next hop VPC connector ID to filter for. Only routes with a matching next hop VPC connector ID will be returned. (UUID format)",
            "schema": {
              "type": "string",
              "example": "6170692e-7363-616c-6577-61792e636f6d"
            }
          },
          {
            "in": "query",
            "name": "contains",
            "description": "Only routes whose destination is contained in this subnet will be returned. (IP network)",
            "schema": {
              "type": "string",
              "example": "1.2.3.4/32"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "description": "Tags to filter for, only routes with one or more matching tags will be returned.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "query",
            "name": "is_ipv6",
            "description": "Only routes with an IPv6 destination will be returned.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/scaleway.vpc.v2.ListRoutesWithNexthopResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "scaleway": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "cURL",
            "source": "curl -X GET \\\n  -H \"X-Auth-Token: $SCW_SECRET_KEY\" \\\n  \"https://api.scaleway.com/vpc/v2/regions/{region}/routes-with-nexthop\""
          },
          {
            "lang": "HTTPie",
            "source": "http GET \"https://api.scaleway.com/vpc/v2/regions/{region}/routes-with-nexthop\" \\\n  X-Auth-Token:$SCW_SECRET_KEY"
          }
        ]
      }
    }
  }
}
